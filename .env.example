# Copy this file to .env in the project root and fill in your own credentials.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_API_KEY=

# Optional Gemini model override
GEMINI_MODEL=gemini-3.6-flash

# Local Vite development origins allowed to connect to FastAPI.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
